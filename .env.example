# Copy to .env and fill in. Server-only — the real .env is never committed.
# These defaults match the local docker-compose Postgres (dev creds only).
#
# The APP connects as the non-superuser reg_app so Row-Level Security is enforced
# (the superuser `reg` would bypass RLS). reg_app is created by migration 0002.
DATABASE_URL=postgres://reg_app:reg_app_dev_pw@localhost:5432/reg_ai
# MIGRATIONS (drizzle-kit) connect as admin role reg for DDL + role creation.
MIGRATION_DATABASE_URL=postgres://reg:reg_dev_pw@localhost:5432/reg_ai
